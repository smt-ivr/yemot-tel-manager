{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yemot-tel-manager",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The worker always runs first so it can strip the /yemot prefix
    "run_worker_first": true
  }
}
